# Maintainer: Spunky Friends
pkgname=spunkpipe-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Keeps game mods in sync with a game server"
arch=('x86_64')
url="https://github.com/Spunky-Friends/spunkpipe"
license=('MIT' 'Apache-2.0')
provides=('spunkpipe')
conflicts=('spunkpipe')
source_x86_64=("spunkpipe-$pkgver-x86_64.tar.gz::https://github.com/Spunky-Friends/spunkpipe/releases/download/v$pkgver/spunkpipe-$pkgver-x86_64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA_X86_64_LINUX@')

package() {
  install -Dm755 spunkpipe "$pkgdir/usr/bin/spunkpipe"
  install -Dm755 spunkpipe-tray "$pkgdir/usr/bin/spunkpipe-tray"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
